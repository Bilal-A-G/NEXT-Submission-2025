#pragma kernel CSMain
#pragma target 5

RWTexture3D<float4> output;
StructuredBuffer<float3> points;

int tilesX;
int tilesY;
int tilesZ;

int tileSize;

[numthreads(1, 1, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    float closestDist = 10000000;

    int tileIndexX = id.x / tileSize;
    int tileIndexY = id.y / tileSize;
    int tileIndexZ = id.z / tileSize;
    
    for (int i = -1; i <= 1; i++)
    {
        uint xIndex = (uint)(tileIndexX + i + tilesX) % tilesX;
        float xOffset = ((float)(tileIndexX + i)/(float)tilesX - (float)xIndex/(float)tilesX) * tilesX;

        for (int j = -1; j <= 1; j++)
        {
            uint yIndex = (uint)(tileIndexY + j + tilesY) % tilesY;
            float yOffset = ((float)(tileIndexY + j)/(float)tilesY - (float)yIndex/(float)tilesY) * tilesY;

            for (int k = -1; k <= 1; k++)
            {
                uint zIndex = (uint)(tileIndexZ + k + tilesZ) % tilesZ;
                float zOffset = ((float)(tileIndexZ + k)/(float)tilesZ - (float)zIndex/(float)tilesZ) * tilesZ;
                
                int flattenedIndex = zIndex * tilesX * tilesY + yIndex * tilesX + xIndex;

                float3 currentPoint = points[flattenedIndex] + float3(xOffset, yOffset, zOffset) * tileSize;

                float dist = pow(id.x - currentPoint.x, 2) + pow(id.y - currentPoint.y, 2) + pow(id.z - currentPoint.z, 2);
                if(closestDist > dist)
                    closestDist = dist;   
            }
        }
    }

    output[id.xyz] = float4(closestDist, 0, 0, 0);
}
